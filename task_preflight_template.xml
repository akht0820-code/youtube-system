      <StartBoundary>2026-03-31T13:00:00+09:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "C:\Users\user\Desktop\youtube-system\run_preflight.bat"</Arguments>
    </Exec>
  </Actions>
