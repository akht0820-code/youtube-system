# .env.example — このファイルをコピーして .env を作成する
# ※ APIキー等の秘密情報はここに書かず setup_secrets.py で登録すること

NTFY_TOPIC=your-ntfy-topic-name
SPREADSHEET_ID=your-google-spreadsheet-id

ANALYTICS_COLLECTOR=youtube
ANALYTICS_STORE=sheets
ANALYTICS_MODEL=gemini

# ── TTSプロバイダ設定 ──────────────────────────────────────────
# TTS_PROVIDER=aquestalk          # デフォルト: AquesTalk1（霊夢=f1, 魔理沙=f2）

# ── 音声設定 ──────────────────────────────────────────────────
# AquesTalk1の話速は tts_aquestalk.py の _SPEED_MAP で管理（reimu=118, marisa=138）

# 音声後処理パイプライン
# AUDIO_TARGET_DBFS=-20.0        # RMS正規化の目標音量（dBFS）
# AUDIO_TRIM_SILENCE=true        # 無音トリム（true/false）
# AUDIO_TRIM_THRESHOLD=400       # 無音判定の閾値（0〜32767）
# AUDIO_TRIM_MARGIN_MS=30        # トリム後に残す余白（ms）
# AUDIO_FADE_IN_MS=15            # フェードイン長さ（ms）
# AUDIO_FADE_OUT_MS=80           # フェードアウト長さ（ms）
# AUDIO_GAIN_霊夢=2.0            # 霊夢の追加ゲイン（dB）+で音量アップ
# AUDIO_GAIN_魔理沙=0.0          # 魔理沙の追加ゲイン（dB）

# AI背景画像生成（省略時はimagen）
# IMAGE_PROVIDER=imagen         # デフォルト: Imagen 4 Fast・アニメ調ボカシ背景（~$0.02/動画）
# IMAGE_PROVIDER=gemini         # Gemini画像生成（LLMプロンプト自動生成・GEMINI_API_KEY共用）
# IMAGE_PROVIDER=pollinations   # フォールバック: 無料・APIキー不要
# IMAGE_PROVIDER=local_sd       # ローカルStable Diffusion（GPU必要）
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview  # gemini使用時のモデル名
# SD_WEBUI_URL=http://127.0.0.1:7860             # local_sd使用時のURL

# セクション画像生成（動画内で背景に表示される各セクションのイラスト）
# SECTION_IMAGE_PROVIDER=imagen        # デフォルト: Imagen 4 Fast（~$0.02/枚・GEMINI_API_KEY共用）
# SECTION_IMAGE_PROVIDER=gemini        # Gemini画像生成モデル（GEMINI_API_KEY共用）
# SECTION_IMAGE_PROVIDER=pollinations  # フォールバック: 無料・APIキー不要
# SECTION_IMAGE_PROVIDER=off           # 無効化（いらすとやのみ使用）

# セリフ中のクリップアートイラスト（画面中央に表示）
# CLIPART_PROVIDER=gemini              # デフォルト: Gemini Proでイラスト生成（~$0.04/枚）
# CLIPART_PROVIDER=irasutoya           # 従来のいらすとや検索

# ── プロソディ（発話の抑揚）─────────────────────────────────────
# PROSODY_ENABLED=true                 # Gemini Proによる抑揚判定（true/false）
                                       # false にすると即座に全行デフォルトに戻る
